{
  "name": "pr-preflight-extension",
  "private": true,
  "version": "0.1.2",
  "description": "A self-review checklist on GitHub's compare page. Six diff checks, no API key, no data leaves github.com.",
  "repository": {
    "type": "git",
    "url": "https://github.com/devanshchoudhary20/pr-preflight"
  },
  "author": "devanshchoudhary20",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint && node scripts/check-comments.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "package": "node scripts/package.mjs",
    "e2e": "node scripts/e2e-extension.mjs",
    "store-shots": "node scripts/store-shots.mjs"
  },
  "dependencies": {
    "parse-diff": "0.12.0",
    "picomatch": "^4.0.7",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "5.3.3",
    "vite": "5.4.21",
    "vitest": "^3.2.7"
  }
}
